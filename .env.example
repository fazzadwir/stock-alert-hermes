APP_ENV=development
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO

# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# Daftar user ID Telegram yang diizinkan, pisahkan dengan koma
# Cari user ID dengan bot @userinfobot
TELEGRAM_ALLOWED_USER_IDS=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/marketpulse.db

# Market Data
MARKET_PROVIDER=yfinance
REQUEST_TIMEOUT_SECONDS=15
QUOTE_CACHE_SECONDS=60
MAX_WATCHLIST_ASSETS=30
MAX_ACTIVE_ALERTS=50

# Hermes Agent Integration (Phase 5)
# disabled | cli | serve
HERMES_MODE=disabled
HERMES_COMMAND=hermes
HERMES_TIMEOUT_SECONDS=60
